
#[hash160("0x726cb6e0cd8628a1350a611384688911ab75f51b")]
declare contract CryptoLib {

    string recoverSecp256K1(string message, string signature);

    string sha256(string message);

    string ripemd160(string message);

    string keccak256(string message);

    string murmur32(string message, int seed);

    bool verifyWithECDsa(string message, string pubkey, string signature, int curve);

    bool verifyWithEd25519(string message, string pubkey, string signature);
}
